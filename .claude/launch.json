{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:demo"
      ],
      "port": 5174
    },
    {
      "name": "fullstack-local",
      "runtimeExecutable": "vercel",
      "runtimeArgs": [
        "dev",
        "--listen",
        "127.0.0.1:3005"
      ],
      "port": 3005
    },
    {
      "name": "ui-demo-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--mode",
        "demo",
        "--port",
        "5184",
        "--strictPort"
      ],
      "port": 5184
    }
  ]
}